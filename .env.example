# Copier vers .env ou utiliser python3 scripts/init_env.py.
# Ne jamais versionner .env ; les vrais secrets sont générés par le script.
POSTGRES_USER=tvm
POSTGRES_DB=tvm
POSTGRES_PASSWORD=CHANGE_ME
TVM_DB_PORT=55432
DATABASE_URL=postgresql://tvm:CHANGE_ME@127.0.0.1:55432/tvm
DJANGO_SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=0
# Activer ces deux options seulement derrière un proxy HTTPS de confiance.
DJANGO_TRUST_PROXY_HEADERS=0
DJANGO_SSL_REDIRECT=0
TVM_TIMEZONE=Africa/Lagos
# Rappels internes opt-in à 08:00 ; aucune connexion WhatsApp ni aucun envoi externe.
TVM_REMINDER_POLL_SECONDS=60
# Envois externes désactivés. Renseigner les accès uniquement dans .env privé.
# SMTP : TLS explicite (587) OU SSL (465), jamais les deux ni une connexion nue.
TVM_EMAIL_ENABLED=0
TVM_SMTP_HOST=
TVM_SMTP_PORT=587
TVM_SMTP_USER=
TVM_SMTP_PASSWORD=
TVM_SMTP_FROM_EMAIL=
TVM_SMTP_USE_TLS=1
TVM_SMTP_USE_SSL=0
TVM_NOTIFICATION_TIMEOUT=10
# WhatsApp Cloud API : modèle approuvé à 5 paramètres, accès à connecter plus tard.
TVM_WHATSAPP_ENABLED=0
TVM_WHATSAPP_TOKEN=
TVM_WHATSAPP_PHONE_ID=
TVM_WHATSAPP_API_VERSION=
TVM_WHATSAPP_TEMPLATE=
TVM_WHATSAPP_LANGUAGE=fr
# Assistant diagnostic : bibliothèque locale utilisable sans clé.
# L'analyse externe nécessite une activation explicite et une clé serveur.
# Ne jamais coller la clé dans le chat ni dans un fichier frontend.
TVM_AI_ENABLED=0
TVM_AI_API_KEY=
TVM_AI_MODEL=gpt-4.1-mini
TVM_AI_TIMEOUT=20
TVM_DEMO_MODE=0
# Uniquement pour la commande seed_demo ; ne pas réutiliser en production.
TVM_DEMO_PASSWORD=
